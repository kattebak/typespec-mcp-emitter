{
	"name": "@kattebak/typespec-mcp-emitter",
	"version": "0.0.0",
	"description": "TypeSpec emitter that generates an MCP tool catalogue from HTTP operations",
	"type": "module",
	"main": "dist/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kattebak/typespec-mcp-emitter.git"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"tsp"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js",
			"typespec": "./tsp/main.tsp"
		}
	},
	"scripts": {
		"fix": "npx @biomejs/biome check --write",
		"lint": "npx @biomejs/biome check",
		"build": "tsc",
		"test": "npm run build && npm run lint && npm run test:unit && npm run test:emit && npm run test:example",
		"test:unit": "node --test --test-timeout=60000 --import=tsx 'src/**/*.test.ts'",
		"test:emit": "tsp compile test/petstore/main.tsp --config test/petstore/tspconfig.yaml",
		"test:example": "node --test --test-timeout=60000 test/petstore-example.js",
		"prepublishOnly": "tsc"
	},
	"dependencies": {
		"@typespec/compiler": "^1.4.0",
		"@typespec/http": "^1.13.0",
		"@typespec/openapi": "^1.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@types/node": "^22.18.11",
		"@typespec/openapi3": "^1.13.0",
		"ajv": "^8.20.0",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"semantic-release": "^25.0.7",
		"tsx": "^4.20.5",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@typespec/openapi3": "^1.13.0"
	}
}
